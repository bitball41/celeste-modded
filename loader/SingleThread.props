<Project>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);CELESTE_SINGLE_THREAD</DefineConstants>
    <WasmEnableThreads>false</WasmEnableThreads>
    <WasmEnableJSPI>true</WasmEnableJSPI>
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmRunWasmOpt>false</WasmRunWasmOpt>
    <EmccExtraLDFlags>-sMIN_WEBGL_VERSION=2 -sWASMFS -sASYNCIFY=2 -sMAXIMUM_MEMORY=4294901760</EmccExtraLDFlags>
    <MicrosoftNetCoreAppRuntimePackDir>$(CelesteRuntimePack)</MicrosoftNetCoreAppRuntimePackDir>
    <MicrosoftNetCoreAppRuntimePackRidDir>$(CelesteRuntimePack)/runtimes/browser-wasm</MicrosoftNetCoreAppRuntimePackRidDir>
    <__EmscriptenSdkToolsPath>$(CelesteEmsdk)/upstream/</__EmscriptenSdkToolsPath>
    <__EmscriptenUpstreamBinPath>$(CelesteEmsdk)/upstream/bin/</__EmscriptenUpstreamBinPath>
    <__EmscriptenUpstreamEmscriptenPath>$(CelesteEmsdk)/upstream/emscripten/</__EmscriptenUpstreamEmscriptenPath>
    <__EmscriptenNodeToolsPath>$(CelesteNode)</__EmscriptenNodeToolsPath>
    <__WasmClang>$(CelesteEmsdk)/upstream/emscripten/emcc</__WasmClang>
    <WasmCachePath>$(CelesteEmsdk)/upstream/emscripten/cache/</WasmCachePath>
  </PropertyGroup>
  <ItemGroup>
    <EmscriptenEnvVars Include="WASM_ENABLE_JSPI=1" />
    <NativeFileReference Remove="../statics/SDL3.a;../statics/FNA3D.a;../statics/FAudio.a;../statics/libmojoshader.a;../statics/liba.o;../statics/hot_reload_detour.o;../statics/libcrypto.a" />
    <NativeFileReference Include="../statics/singlethread/SDL3.a;../statics/singlethread/FNA3D.a;../statics/singlethread/FAudio.a;../statics/singlethread/libmojoshader.a;../statics/singlethread/liba.o;../statics/singlethread/hot_reload_detour.o;../statics/singlethread/libcrypto.a" />
  </ItemGroup>
  <Target Name="ValidateSingleThreadInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(CelesteRuntimePack)/runtimes/browser-wasm/native/libmonosgen-2.0.a')" Text="Set CelesteRuntimePack to the extracted ST-dotnet-jspi runtime pack." />
    <Error Condition="!Exists('$(__WasmClang)')" Text="Set CelesteEmsdk to Emscripten 4.0.23 and CelesteNode to its node executable." />
  </Target>
</Project>
